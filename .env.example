# Copy to .env (or point SECRETS_FILE at it) and fill in. Never commit the filled-in copy.
# The reader looks in $SECRETS_FILE, then ~/.env. Lines may be `NAME=value` or `export NAME=value`.

# ─── The model that reads the book ────────────────────────────────────────────
# Any OpenAI-compatible endpoint works; DeepSeek is the default in the docs because it is cheap
# and its official pricing is public. Anthropic, Gemini and Ollama are spoken natively too.
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
EXTRACT_MODEL=deepseek-flash+nothink
# +nothink matters: DeepSeek V4 reasons by default, which costs 4 minutes and 18k tokens a segment
# for no gain on extraction.

# Several providers at once: route by model-name prefix.
# LLM_KEY_MAP=deepseek-=DEEPSEEK_KEY,gemini-=GOOGLE_KEY,claude-=ANTHROPIC_KEY
# LLM_PROTOCOL_MAP=claude-=anthropic,gemini-=gemini,llama=ollama
# LLM_BASE_URL_ANTHROPIC=https://api.anthropic.com/v1

# Different jobs can use different models; each falls back to EXTRACT_MODEL.
# RECAP_MODEL=          summaries between chapters
# QA_MODEL=             answering questions about the book
# MARGINALIA_MODEL=     writing short source-anchored reading comments (falls back to QA_MODEL)
# CLASSIFY_MODEL=       deciding what a chapter is
# LLM_TIMEOUT=600       seconds without data before a call is given up on (default: 3x the slowest recent reply, 90-600 s)
# LLM_RETRIES=4

# ─── The judge ────────────────────────────────────────────────────────────────
# A multiple-choice model that returns calibrated probabilities. The pipeline leans on it for
# merging characters, checking every record against the passage, the relation tree, and deciding
# what a chapter title gives away. Three ways to have one, cheapest first:
#
#  1. free-only (default): keyless classifier.dev; provider quotas apply.
#     Failure never switches to a paid provider. The legacy free name is an alias.
#  2. your own, on your own machine: any service speaking the same protocol
#     (reference server: scripts/judge_server.py). See docs/SELF-HOSTING.md.
#  3. paid: any endpoint that speaks the evaluate API.
#
# CLASSIFIER_URL=http://127.0.0.1:8008/v1/evaluate
# JEV_ROUTE=local         # use only CLASSIFIER_URL, never a paid judge
JEV_ROUTE=free-only       # free-only | free-then-paid | paid | local
# JEV_PAID_MAX_CALLS=0    # hard cap; zero forbids paid calls
# JEV_PAID_MAX_CHARS=0    # hard cap; each uncertain attempt is counted
# JEV_BUDGET_FILE=/private/run/paid-budget.json  # durable shared ledger for paid modes
# JEV_URL=https://ai-gateway.vercel.sh/v1/evaluate
# JEV_MODEL=typesafe-ai/jev
# JEV_API_KEY=
# JEV_CONCURRENCY=6      how many judge calls at once
# JEV_MAX_WAIT=60        maximum accepted wait from a provider retry hint
# JEV_MAX_COOLDOWN=21600 longest a failing route is skipped for
# MARGINALIA_MIN_SCORE=0.58  automatic comments stay quiet below this JEV noteworthiness score

# Turn individual uses of the judge off to save calls (all default on):
# JUDGE_RELATIONS=0 JUDGE_ATTRS=0 JUDGE_TITLES=0 JUDGE_IMPORTANCE=0 JUDGE_RETRIEVAL=0
# VERIFY_RECORDS=0       stop checking every extracted record against its passage
# Historical JUDGE_FALLBACK chat substitution is disabled: it bypassed the paid-attempt
# ledger and changed the probability contract. Select an explicit judge route instead.

# Keep every judged question and its full probability distribution, to train a judge of your own.
# JUDGE_LOG=1            (on by default; written under each book's work/judge/)

# ─── What it costs you ───────────────────────────────────────────────────────
# The built-in price table uses list prices, which may not be what you pay. State
# yours and the shelf's estimate and the per-book spend both follow. Two numbers per model, input
# and output, per million tokens, in whatever currency you think in.
# MODEL_PRICES={"deepseek-flash": [1.0, 4.0], "gemini-2.5-flash-lite": [0.72, 2.88]}
# JEV_PRICE_OVERRIDE=0      the judge's price per million input tokens — 0 when you run your own

# ─── The web server ───────────────────────────────────────────────────────────
# PASSCODE=              leave empty for no password
# DATA_DIR=              where books are stored (default: <app>/data)
# WEB_DIR=               where the front end lives (default: <app>/web)
# AUTO_PROCESS=0         1 = start reading an uploaded book at once. 0 means the reader presses
#                        the button themselves, after seeing the estimated time and cost — which
#                        is the right default when it is their money.
# the port is a flag, not an env var:  python3 -m server.app --port 18770

# COOKIE_SECURE=1       default; require HTTPS for authenticated production use
# COOKIE_SECURE=0       only for an isolated local HTTP development server
# YEDU_RELEASE_ID=      set by validated deployment, visible in health/header responses
