# books, their knowledge graphs and everything the pipeline produces stay on your machine
data/
# Flutter's data access source is code, not a local book library.
!app/lib/data/
!app/lib/data/**
testsets/*/*.txt

# filled-in secrets — .env.example is the one that is committed
.env
secrets.env
*.key
*.jks
*.keystore

# build output
android/app/build/
android/build/
android/.gradle/
android/local.properties
web/download/
*.apk

__pycache__/
*.pyc
*.tmp
.pytest_cache/
.venv*/
.DS_Store
core/.dart_tool/
core/coverage/

# cassette budget and tape flock files are created locally during recording
oracle/cassettes/live/.budget.lock
oracle/cassettes/live/.tape.lock
