# books, their knowledge graphs and everything the pipeline produces stay on your machine
data/
# Flutter's data access source is code, not a local book library.
!app/lib/data/
!app/lib/data/**
reference/testsets/*/*.txt

# filled-in secrets never belong in source control
.env
secrets.env
*.key
*.jks
*.keystore

# build output
reference/web/download/
*.apk

__pycache__/
*.pyc
*.tmp
.pytest_cache/
.venv*/
.DS_Store
core/.dart_tool/
core/coverage/

# cassette budget and tape flock files are created locally during recording
reference/oracle/cassettes/live/.budget.lock
reference/oracle/cassettes/live/.tape.lock
